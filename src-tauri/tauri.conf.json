{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyboard Dances",
  "version": "0.1.0",
  "identifier": "dev.keyboarddances.keyboarddances",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keyboard Dances",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "icon": ["icons/icon.png"],
    "shortDescription": "Keyboard sound profile switcher",
    "longDescription": "A tray application for switching keyboard press and release sounds."
  }
}
